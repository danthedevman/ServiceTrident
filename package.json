{
  "name": "servicetrident",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "app",
    "workers",
    "shared"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:app": "npm run dev -w app",
    "dev:workers": "npm run dev -w workers",
    "dev:scheduler": "npm run dev:scheduler -w workers",
    "build": "npm run build -w app",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "lint": "eslint api app/src workers shared test eslint.config.js",
    "format": "prettier --write api app workers shared test docs *.json *.yaml *.md eslint.config.js",
    "format:check": "prettier --check api app workers shared test docs *.json *.yaml *.md eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
